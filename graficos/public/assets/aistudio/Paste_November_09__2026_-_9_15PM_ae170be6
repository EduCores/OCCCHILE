<div class="h-full rounded-full bg-slate-400 transition-all duration-700" style="width: 68.6%;"></div>
</div>
</div>
</div>
<span class="text-[11px] text-slate-600 mt-2 block">
          Umbral óptimo garantizado bajo balance dinámico.
        </span>
</div>
</div>
<!-- Botones de Acción Glassmórficos del Modal -->
<div class="pt-5 border-t border-white/70 flex flex-wrap items-center justify-between gap-3">
<div class="flex items-center gap-2">
<button class="px-4 py-2 rounded-full bg-white/80 hover:bg-white text-slate-800 text-xs font-semibold shadow-sm border border-white transition-all flex items-center gap-1.5" id="btn-pause-node">
<span class="material-symbols-outlined text-[16px] text-amber-600">pause_circle</span>
          Pausar Balanceo
        </button>
<button class="px-4 py-2 rounded-full bg-white/80 hover:bg-white text-slate-800 text-xs font-semibold shadow-sm border border-white transition-all flex items-center gap-1.5" id="btn-download-logs">
<span class="material-symbols-outlined text-[16px] text-slate-700">description</span>
          Descargar Logs
        </button>
</div>
<button class="px-6 py-2 rounded-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold shadow-md transition-all ml-auto" id="btn-close-modal-alt">
        Cerrar
      </button>
</div>
</div>
</div>
<!-- Interactividad y Lógica del Modal -->
<script>
  (function() {
    // 1. Refresco suave en botón footer existente
    const refreshBtn = document.querySelector('footer button:first-child');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', function() {
        const icon = this.querySelector('.material-symbols-outlined');
        if (icon) {
          icon.classList.add('animate-spin');
          setTimeout(() => {
            icon.classList.remove('animate-spin');
          }, 800);
        }
      });
    }

    // 2. Elementos del Modal
    const modal = document.getElementById('glass-metric-modal');
    const modalBackdrop = document.getElementById('modal-backdrop');
    const modalContainer = document.getElementById('modal-container');
    const btnClose = document.getElementById('btn-close-modal');
    const btnCloseAlt = document.getElementById('btn-close-modal-alt');

    // Nodos dinámicos del contenido del modal
    const modalTitle = document.getElementById('modal-node-title');
    const modalSubtitle = document.getElementById('modal-node-subtitle');
    const modalBadgeCategory = document.getElementById('modal-badge-category');
    const modalStatusBadge = document.getElementById('modal-status-badge');
    const modalStatusDot = document.getElementById('modal-status-dot');
    const metricLoad = document.getElementById('modal-metric-load');
    const metricLoadDelta = document.getElementById('modal-metric-load-delta');
    const metricBandwidth = document.getElementById('modal-metric-bandwidth');
    const metricLatency = document.getElementById('modal-metric-latency');
    const metricPackets = document.getElementById('modal-metric-packets');
    const metricError = document.getElementById('modal-metric-error');
    const metricTemp = document.getElementById('modal-metric-temp');
    const barLabelNode = document.getElementById('modal-bar-label-node');
    const barValNode = document.getElementById('modal-bar-val-node');
    const barFillNode = document.getElementById('modal-bar-fill-node');
    const efficiencyBadge = document.getElementById('modal-efficiency-badge');

    // Abre el modal con transición suave
    function openModal(data) {
      modalTitle.textContent = data.title;
      modalSubtitle.textContent = data.subtitle || 'Telemetría en tiempo real y asignación dinámica de carga de clúster.';
      modalBadgeCategory.textContent = data.category || 'Métrica Activa';
      
      metricLoad.textContent = data.val || '68%';
      const numericVal = parseInt(data.val) || 68;
      
      // Color y gradiente dinámico
      if (data.grad) {
        barFillNode.className = 'h-full rounded-full transition-all duration-700 ' + data.grad;
      } else {
        barFillNode.className = 'h-full rounded-full transition-all duration-700 grad-blue';
      }
      barFillNode.style.width = numericVal + '%';
      barLabelNode.textContent = (data.nodeId ? 'Canal ' + data.nodeId : data.title) + ' (Actual)';
      barValNode.textContent = numericVal + '%';

      // Cálculo de ancho de banda y latencia proporcionales simulados
      const bw = ((numericVal / 100) * 5.8).toFixed(2);
      metricBandwidth.textContent = bw;
      
      const lat = (8 + (numericVal * 0.08)).toFixed(1);
      metricLatency.textContent = lat;

      const packets = ((numericVal * 0.18) + 2.5).toFixed(1) + 'M';
      metricPackets.textContent = packets;

      // Estado condicional
      if (numericVal >= 90) {
        modalStatusDot.className = 'w-3 h-3 rounded-full bg-amber-500 animate-pulse shadow-sm';
        modalStatusBadge.textContent = 'Alerta / Umbral Alto';
        metricError.textContent = '0.04%';
        metricError.className = 'text-2xl font-bold text-amber-600';
        metricTemp.textContent = '49°C';
        efficiencyBadge.textContent = '+26.4% Pico Máx';
        efficiencyBadge.className = 'text-[11px] font-semibold text-amber-700 bg-amber-100/80 px-2 py-0.5 rounded-full';
        metricLoadDelta.textContent = '+18.2%';
        metricLoadDelta.className = 'text-[11px] text-amber-600 font-semibold';
      } else if (numericVal <= 35) {
        modalStatusDot.className = 'w-3 h-3 rounded-full bg-rose-500 animate-ping shadow-sm';
        modalStatusBadge.textContent = 'Carga Crítica / Desbalance';
        metricError.textContent = '0.08%';
        metricError.className = 'text-2xl font-bold text-rose-600';
        metricTemp.textContent = '38°C';
        efficiencyBadge.textContent = '-33.6% Subutilizado';
        efficiencyBadge.className = 'text-[11px] font-semibold text-rose-700 bg-rose-100/80 px-2 py-0.5 rounded-full';
        metricLoadDelta.textContent = '-12.0%';
        metricLoadDelta.className = 'text-[11px] text-rose-600 font-semibold';
      } else {
        modalStatusDot.className = 'w-3 h-3 rounded-full bg-emerald-500 animate-pulse shadow-sm';
        modalStatusBadge.textContent = 'En Línea / Óptimo';
        metricError.textContent = '0.01%';
        metricError.className = 'text-2xl font-bold text-emerald-700';
        metricTemp.textContent = '42°C';
        efficiencyBadge.textContent = '+11.8% Eficiencia';
        efficiencyBadge.className = 'text-[11px] font-semibold text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded-full';
        metricLoadDelta.textContent = '+3.5%';
        metricLoadDelta.className = 'text-[11px] text-emerald-600 font-semibold';
      }

      // Animación de despliegue
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modalContainer.classList.remove('scale-95');
      modalContainer.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
    }

    // Cierra el modal con animación
    function closeModal() {
      modal.classList.add('opacity-0', 'pointer-events-none');
      modalContainer.classList.remove('scale-100');
      modalContainer.classList.add('scale-95');
      document.body.style.overflow = '';
    }

    // Escuchar cierres (click afuera, botones, ESC)
    if (btnClose) btnClose.addEventListener('click', closeModal);
    if (btnCloseAlt) btnCloseAlt.addEventListener('click', closeModal);
    if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);

    window.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !modal.classList.contains('pointer-events-none')) {
        closeModal();
      }
    });

    // 3. Conectar las 18 barras interactivas
    const pillBars = document.querySelectorAll('.interactive-pill');
    pillBars.forEach(bar => {
      bar.addEventListener('click', function() {
        const id = this.getAttribute('data-bar-id');
        const val = this.getAttribute('data-val');
        const cat = this.getAttribute('data-category');
        const grad = this.getAttribute('data-grad');

        openModal({
          nodeId: id,
          title: `Detalle del Nodo: Canal ${id}`,
          subtitle: `Telemetría individual de rendimiento para el bus balanceado ${id}.`,
          category: cat,
          val: val,
          grad: grad
        });
      });

      // Accesibilidad con teclado (Enter o Espacio)
      bar.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          this.click();
        }
      });
    });

    // 4. Conectar también las tarjetas superiores (Anillos y Gráfica de Onda)
    const radialCard = document.querySelector('[data-metric-type="radial-gauges"]');
    if (radialCard) {
      radialCard.addEventListener('click', function(e) {
        openModal({
          nodeId: 'GLOBAL-SLA',
          title: 'Telemetría Operativa: Objetivos & SLA',
          subtitle: 'Disponibilidad consolidada de todos los clusters (94%) y fase activa (68%).',
          category: 'Disponibilidad Global',
          val: '94%',
          grad: 'grad-emerald'
        });
      });
    }

    const waveCard = document.querySelector('[data-metric-type="wave-chart"]');
    if (waveCard) {
      waveCard.addEventListener('click', function(e) {
        openModal({
          nodeId: 'FLOW-WEEKLY',
          title: 'Volumen y Tendencia de Flujo Semanal',
          subtitle: 'Análisis telemetry continuo. Pico registrado el Jueves con 82.4 req/s.',
          category: 'Tendencia Semanal',
          val: '82%',
          grad: 'grad-purple'
        });
      });
    }

    // Botones adicionales dentro del modal
    const pauseBtn = document.getElementById('btn-pause-node');
    if (pauseBtn) {
      pauseBtn.addEventListener('click', function() {
        const isPaused = this.getAttribute('data-paused') === 'true';
        if (!isPaused) {
          this.setAttribute('data-paused', 'true');
          this.innerHTML = '<span class="material-symbols-outlined text-[16px] text-emerald-600">play_circle</span> Reanudar Balanceo';
          modalStatusBadge.textContent = 'Pausado Manualmente';
          modalStatusDot.className = 'w-3 h-3 rounded-full bg-slate-400';
        } else {
          this.setAttribute('data-paused', 'false');
          this.innerHTML = '<span class="material-symbols-outlined text-[16px] text-amber-600">pause_circle</span> Pausar Balanceo';
          modalStatusBadge.textContent = 'En Línea / Óptimo';
          modalStatusDot.className = 'w-3 h-3 rounded-full bg-emerald-500 animate-pulse';
        }
      });
    }

    const downloadBtn = document.getElementById('btn-download-logs');
    if (downloadBtn) {
      downloadBtn.addEventListener('click', function() {
        const origText = this.innerHTML;
        this.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">sync</span> Descargando...';
        setTimeout(() => {
          this.innerHTML = '<span class="material-symbols-outlined text-[16px] text-emerald-600">check_circle</span> Logs Guardados';
          setTimeout(() => {
            this.innerHTML = origText;
          }, 1500);
        }, 800);
      });
    }

  })();
</script></main>
<!-- END: MainShowcaseContainer -->
</body></html>